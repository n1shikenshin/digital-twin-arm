        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "arm-sqlite"
          },
          "refId": "A",
          "queryText": "SELECT ROUND(AVG(temp),1) AS \"Mean temp (C)\", MAX(temp) AS \"Max temp (C)\", ROUND(AVG(current),2) AS \"Mean current (A)\", MAX(current) AS \"Max current (A)\", SUM(baseline_alarm) AS \"Threshold alarm samples\", SUM(ai_label IN ('overtemp','overcurrent')) AS \"AI fault samples\", COUNT(*) AS \"Samples\" FROM readings WHERE asset_id='arm_01' AND CAST(strftime('%s', recv_ts) AS INTEGER) BETWEEN $__from / 1000 AND $__to / 1000",
          "rawQueryText": "SELECT ROUND(AVG(temp),1) AS \"Mean temp (C)\", MAX(temp) AS \"Max temp (C)\", ROUND(AVG(current),2) AS \"Mean current (A)\", MAX(current) AS \"Max current (A)\", SUM(baseline_alarm) AS \"Threshold alarm samples\", SUM(ai_label IN ('overtemp','overcurrent')) AS \"AI fault samples\", COUNT(*) AS \"Samples\" FROM readings WHERE asset_id='arm_01' AND CAST(strftime('%s', recv_ts) AS INTEGER) BETWEEN $__from / 1000 AND $__to / 1000",
          "queryType": "table",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
