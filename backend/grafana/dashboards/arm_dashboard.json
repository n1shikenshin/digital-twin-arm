    {
      "id": 11,
      "type": "stat",
      "title": "Aggregates over the selected time range",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "arm-sqlite"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
